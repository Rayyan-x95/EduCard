#!/bin/sh
# EduCard pre-commit audit hook
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Runs on every `git commit`:
#   1. Secret scan of staged content (blocks credential leaks at the source)
#   2. TypeScript typecheck of the working tree
#   3. ESLint on staged JS/TS/JSX/TSX files only (fast)
#
# Full test suite + build run in CI — the hook stays under ~15 seconds.
# Bypass in a genuine emergency with `git commit --no-verify`.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0

echo "==> Pre-commit audit"

# ---------------------------------------------------------------------------
# 1. Secret scan on staged content
# ---------------------------------------------------------------------------
STAGED=$(git diff --cached --diff-filter=ACM --unified=0 -- ':(exclude).githooks')

if [ -n "$STAGED" ]; then
  SCAN_RESULT=$(printf '%s' "$STAGED" | node -e '
    let input = "";
    process.stdin.on("data", (c) => (input += c));
    process.stdin.on("end", () => {
      const patterns = [
        [/AKIA[0-9A-Z]{16}/, "AWS access key"],
        [/-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----/, "Private key"],
        [/sk_live_[A-Za-z0-9]{20,}/, "Stripe live secret key"],
        [/\beyJhbGciOi[A-Za-z0-9._-]{50,}\b/, "JWT token"],
        [/expo_[A-Za-z0-9_-]{20,}/i, "Expo access token"],
        [/gh[pousr]_[A-Za-z0-9_]{36,}/, "GitHub token"],
        [/(api[_-]?key|secret|password|passwd|token)\s*[:=]\s*["\x27][^"\x27\s]{16,}["\x27]/i, "Hardcoded credential"],
      ];
      const hits = [];
      for (const [re, label] of patterns) {
        if (re.test(input)) hits.push(label);
      }
      process.stdout.write(hits.join("\n"));
    });
  ')

  if [ -n "$SCAN_RESULT" ]; then
    printf "${RED}✗ Commit blocked: possible secrets in staged changes${NC}\n"
    printf '%s\n' "$SCAN_RESULT" | sed 's/^/    - /'
    echo ""
    echo "  If this is a false positive, commit with --no-verify."
    FAILED=1
  else
    printf "${GREEN}✓ No secrets detected in staged changes${NC}\n"
  fi
fi

# ---------------------------------------------------------------------------
# 2. Typecheck (working tree)
# ---------------------------------------------------------------------------
echo "==> Typecheck"
if ! npx tsc --noEmit --pretty false; then
  printf "${RED}✗ Commit blocked: typecheck failed${NC}\n"
  FAILED=1
fi

# ---------------------------------------------------------------------------
# 3. ESLint on staged JS/TS files only
# ---------------------------------------------------------------------------
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$' || true)

if [ -n "$STAGED_TS" ]; then
  echo "==> Lint (staged files)"
  # shellcheck disable=SC2086
  if ! npx eslint $STAGED_TS; then
    printf "${RED}✗ Commit blocked: lint errors${NC}\n"
    FAILED=1
  fi
fi

# ---------------------------------------------------------------------------
if [ "$FAILED" -ne 0 ]; then
  printf "${RED}Pre-commit audit FAILED — fix the issues above or use --no-verify to bypass.${NC}\n"
  exit 1
fi

printf "${GREEN}Pre-commit audit passed ✓${NC}\n"
exit 0
